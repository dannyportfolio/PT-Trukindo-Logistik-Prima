# PT Trukindo Logistik Prima / AstraOps — Environment Configuration Template
# Copy this file to .env.local for local development. DO NOT commit secrets to Git.

# -----------------------------------------------------------------------------
# 1. Server & Runtime Options
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# 2. PostgreSQL Database Connections
# -----------------------------------------------------------------------------
# Application runtime connection (Least-privilege role: astraops_app)
DATABASE_URL=postgresql://astraops_app:app_secure_password@localhost:5432/astraops

# Migration and Schema owner connection (Admin/DDL role: astraops_admin)
# Used by scripts/migrate.ts. If omitted, defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://astraops_admin:adminpass@localhost:5432/astraops

# Port exposed by PostgreSQL container in docker-compose
POSTGRES_PORT=5432

# Connection Pool Tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# 3. Authentication Tokens (Internal AstraOps Operator Access)
# -----------------------------------------------------------------------------
# Bearer / Cookie session tokens for internal desk access (/leads and API routes)
API_AUTH_TOKEN=trukindo-secure-operator-token
ADMIN_AUTH_TOKEN=trukindo-secure-admin-token
VIEWER_AUTH_TOKEN=trukindo-secure-viewer-token

# -----------------------------------------------------------------------------
# 4. Decoupled Deployment & Cross-Origin Configuration (Optional)
# -----------------------------------------------------------------------------
# If the public website is hosted statically (e.g. GitHub Pages or static CDN),
# configure the remote backend API base URL for the quote form.
# Leave empty for unified/standalone deployments (defaults to same-origin /api/inquiries).
# Example: https://api.logistikprima.com
NEXT_PUBLIC_API_URL=

# Comma-separated list of allowed origins for public CORS requests to /api/inquiries.
# Set to '*' to allow any origin, or specify exact domains.
# Example: https://dannyportfolio.github.io,https://logistikprima.com
CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# 5. AI Model Gateway (OpenAI-Compatible Local Endpoint or Direct Provider)
# -----------------------------------------------------------------------------
ROUTER_BASE_URL=http://localhost:20128/v1
LLM_GATEWAY_PROVIDER=9router

# -----------------------------------------------------------------------------
# 6. External Automation & Orchestration (n8n Webhook Integration)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-outreach
N8N_WEBHOOK_SECRET=your_development_hmac_secret_at_least_32_characters_long
