# PT Trukindo Logistik Prima / AstraOps — Production Environment Configuration
# Production Gateway, Database, Authentication, and Automation Settings

NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration (Isolated bridge network in docker-compose.prod.yml)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://astraops_app:app_secure_password@postgres:5432/astraops_prod
MIGRATION_DATABASE_URL=postgresql://astraops_admin:admin_secure_password@postgres:5432/astraops_prod
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL_MODE=auto
DB_APPLICATION_NAME=astraops_prod

# -----------------------------------------------------------------------------
# Internal Operator Desk Authentication (RBAC / Sessions)
# -----------------------------------------------------------------------------
API_AUTH_TOKEN=trukindo-prod-api-operator-token
ADMIN_AUTH_TOKEN=trukindo-prod-admin-root-token
VIEWER_AUTH_TOKEN=trukindo-prod-viewer-token

# -----------------------------------------------------------------------------
# AI Intelligence Engine & 9Router Model Gateway (Milestone 3 Issue #5)
# -----------------------------------------------------------------------------
ROUTER_BASE_URL=http://localhost:20128/v1
LLM_GATEWAY_PROVIDER=9router
LLM_FALLBACK_ON_ERROR=true

# Secondary Direct OpenAI Provider for Seamless Fallback
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=placeholder_direct_openai_api_key_for_production

# -----------------------------------------------------------------------------
# Transactional Email & Internal Sales Alert Dispatcher (Milestone 2 Issue #2)
# -----------------------------------------------------------------------------
RESEND_API_KEY=placeholder_resend_api_key_for_production
EMAIL_FROM=PT Trukindo Logistik Prima <inquiry@trukindo.co.id>
SALES_ALERT_WEBHOOK_URL=https://api.trukindo.co.id/webhook/sales-alerts

# -----------------------------------------------------------------------------
# Fleet Telematics & GPS Integration (Milestone 4 Issue #6)
# -----------------------------------------------------------------------------
TELEMATICS_WEBHOOK_SECRET=trukindo-prod-telematics-secret-2026
